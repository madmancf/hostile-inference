{
  "name": "hostile-inference",
  "private": true,
  "version": "0.20.0",
  "description": "Hostile Inference — animated 3D server-continent RTS",
  "scripts": {
    "start": "node scripts/start-contributor.mjs",
    "dev": "node scripts/start-contributor.mjs",
    "dev:server": "node game/server.mjs",
    "preview:managed": "node scripts/start-preview.mjs",
    "preview:stop": "node scripts/start-preview.mjs --stop",
    "check": "node scripts/check-source.mjs",
    "check:public": "node tests/public-source.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "test": "node scripts/test-source.mjs",
    "test:browser": "node tests/contributor-browser.mjs",
    "test:enemy-balance": "node tests/enemy-balance.mjs",
    "test:ranked": "node tests/ranked.mjs && node tests/ranked-actions.mjs && node tests/ranked-recovery.mjs",
    "test:accounts": "node tests/accounts.mjs",
    "test:leaderboards": "node tests/leaderboards.mjs",
    "start:release": "node scripts/start-release.mjs",
    "test:release": "node tests/release.mjs",
    "test:model-cache": "node tests/model-cache.mjs",
    "ops": "node scripts/operate.mjs",
    "test:verification-jobs": "node tests/verification-jobs.mjs",
    "test:operations": "node tests/operations.mjs",
    "test:account-abuse": "node tests/account-abuse.mjs",
    "test:email": "node tests/email-delivery.mjs",
    "test:history": "node --expose-gc tests/history-growth.mjs && node tests/history-integrity.mjs",
    "test:capacity-soak": "node --expose-gc tests/capacity-soak.mjs",
    "build": "npm run check:assets && node scripts/build-release.mjs"
  },
  "type": "module",
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "meshoptimizer": "^1.1.0",
    "playwright": "1.64.1",
    "sharp": "^0.35.5"
  },
  "license": "MIT",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madmancf/hostile-inference.git"
  },
  "bugs": {
    "url": "https://github.com/madmancf/hostile-inference/issues"
  },
  "homepage": "https://github.com/madmancf/hostile-inference#readme"
}
