# Public source allowlist. Existing private development files remain on disk.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.nvmrc
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CODE_OF_CONDUCT.md
!/AGENTS.md
!/package.json
!/package-lock.json
!/.github/
!/api/
!/release/
!/design-preview/
!/scripts/
!/checks/
!/docs/

# Only source and independently licensed vendor code from the preview tree.
/design-preview/**
!/design-preview/**/
!/design-preview/**/*.js
!/design-preview/**/*.mjs
!/design-preview/**/*.html
!/design-preview/**/*.css
!/design-preview/demo/favicon.svg
!/design-preview/vendor/three/LICENSE
!/design-preview/vendor/meshoptimizer-LICENSE.md
!/design-preview/servers/assets/premium-models.json

/scripts/*
!/scripts/check-source.mjs
!/scripts/test-source.mjs
!/scripts/check-assets.mjs
!/scripts/start-contributor.mjs
!/scripts/start-preview.mjs
!/scripts/build-release.mjs
!/scripts/start-release.mjs
!/scripts/operate.mjs

/checks/*
!/checks/simulation.mjs
!/checks/demo.mjs
!/checks/servers.mjs
!/checks/tutorial.mjs
!/checks/draw-batches.mjs
!/checks/faction-assets.mjs
!/checks/local-game.mjs
!/checks/faction-gameplay.mjs
!/checks/faction-tech.mjs
!/checks/enemy-ai.mjs
!/checks/enemy-balance.mjs
!/checks/ranked.mjs
!/checks/ranked-policy.mjs
!/checks/ranked-actions.mjs
!/checks/ranked-recovery.mjs
!/checks/accounts.mjs
!/checks/leaderboards.mjs
!/checks/model-cache.mjs
!/checks/verification-jobs.mjs
!/checks/operations.mjs
!/checks/account-abuse.mjs
!/checks/email-delivery.mjs
!/checks/history-growth.mjs
!/checks/history-integrity.mjs
!/checks/history-fixture.mjs
!/checks/capacity-server.mjs
!/checks/capacity-soak.mjs
!/checks/contributor-browser.mjs
!/checks/public-source.mjs
!/checks/release.mjs

/docs/*
!/docs/ARCHITECTURE.md
!/docs/ASSETS.md
!/docs/ROADMAP.md
!/docs/TESTING.md
!/docs/runtime-assets.json
!/docs/operations-0.20.md
!/docs/email-setup-0.19.md

# Never publish runtime state, credentials, installed packages or captures.
**/node_modules/
**/output/
**/.runtime/
**/.env
**/.env.*
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/*.log
**/.DS_Store
