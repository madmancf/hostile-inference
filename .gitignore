# Public source allowlist. Existing private development files remain on disk.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.nvmrc
!/README.md
!/LICENSE
!/AGENTS.md
!/package.json
!/package-lock.json
!/.github/
!/api/
!/release/
!/game/
!/scripts/
!/tests/
!/docs/

# Only source and independently licensed vendor code from the preview tree.
/game/**
!/game/**/
!/game/**/*.js
!/game/**/*.mjs
!/game/**/*.html
!/game/**/*.css
!/game/README.md
!/game/demo/favicon.svg
!/game/vendor/three/LICENSE
!/game/vendor/meshoptimizer-LICENSE.md
!/game/servers/assets/premium-models.json

/scripts/*
!/scripts/README.md
!/scripts/doctor.mjs
!/scripts/check-source.mjs
!/scripts/test-source.mjs
!/scripts/check-assets.mjs
!/scripts/start-contributor.mjs
!/scripts/start-preview.mjs
!/scripts/build-release.mjs
!/scripts/start-release.mjs
!/scripts/operate.mjs

/tests/*
!/tests/README.md
!/tests/doctor.mjs
!/tests/simulation.mjs
!/tests/demo.mjs
!/tests/servers.mjs
!/tests/tutorial.mjs
!/tests/draw-batches.mjs
!/tests/faction-assets.mjs
!/tests/local-game.mjs
!/tests/faction-gameplay.mjs
!/tests/faction-tech.mjs
!/tests/enemy-ai.mjs
!/tests/enemy-balance.mjs
!/tests/ranked.mjs
!/tests/ranked-policy.mjs
!/tests/ranked-actions.mjs
!/tests/ranked-recovery.mjs
!/tests/accounts.mjs
!/tests/leaderboards.mjs
!/tests/model-cache.mjs
!/tests/verification-jobs.mjs
!/tests/operations.mjs
!/tests/account-abuse.mjs
!/tests/email-delivery.mjs
!/tests/history-growth.mjs
!/tests/history-integrity.mjs
!/tests/history-fixture.mjs
!/tests/capacity-server.mjs
!/tests/capacity-soak.mjs
!/tests/contributor-browser.mjs
!/tests/public-source.mjs
!/tests/release.mjs

/docs/*
!/docs/README.md
!/docs/THIRD_PARTY_NOTICES.md
!/docs/LOCAL_DEVELOPMENT.md
!/docs/ARCHITECTURE.md
!/docs/ASSETS.md
!/docs/ROADMAP.md
!/docs/STATUS.md
!/docs/TESTING.md
!/docs/runtime-assets.json
!/docs/operations-0.20.md
!/docs/email-setup-0.19.md

# Never publish runtime state, credentials, installed packages or captures.
**/node_modules/
**/output/
**/.runtime/
**/.env
**/.env.*
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/*.log
**/.DS_Store
