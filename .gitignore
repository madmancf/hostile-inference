# Public source allowlist. Existing private development files remain on disk.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.nvmrc
!/README.md
!/LICENSE
!/AGENTS.md
!/package.json
!/package-lock.json
!/.github/
!/api/
!/release/
!/game/
!/scripts/
!/tests/
!/docs/

# Source, vendor code and the explicitly reviewed runtime art pack.
